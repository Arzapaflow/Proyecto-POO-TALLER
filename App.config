<?xml version="1.0" encoding="utf-8" ?>
<configuration>

	<connectionStrings>
		<add name="TallerReparaciones"
			 connectionString="Data Source=TallerReparaciones.db;Version=3;Foreign Keys=True;"
			 providerName="System.Data.SQLite" />
	</connectionStrings>

	<startup>
		<supportedRuntime version="v4.0"
						  sku=".NETFramework,Version=v4.7.2" />
	</startup>

</configuration>